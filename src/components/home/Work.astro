---
import SectionHeading from '../SectionHeading.astro';
import { workHeading } from '~/data/highlights';
import { withBase } from '~/lib/utils';

const invitationTypes = [
  { title: 'Baby showers', image: '/images/preview/babyshower.webp', description: 'Una bienvenida dulce y especial para celebrar la llegada.' },
  { title: 'Bodas', image: '/images/preview/boda.webp', description: 'El comienzo de una historia contada con elegancia y emoción.' },
  { title: 'Bautizos', image: '/images/preview/bautizo.webp', description: 'Un día de fe y familia para guardar en el corazón.' },
  { title: 'Fiestas', image: '/images/preview/cumpleanos.webp', description: 'Colores, alegría y todos los detalles de tu celebración.' },
  { title: 'Aniversarios', image: '/images/preview/aniversario.webp', description: 'Una experiencia para celebrar todo lo que han construido juntos.' },
  { title: 'Graduaciones', image: '/images/preview/graduacion.webp', description: 'Un reconocimiento inolvidable para una meta alcanzada.' },
  { title: 'Festividades religiosas', image: '/images/preview/religioso.webp', description: 'Comparte con tus seres queridos los detalles de un momento de fe.' },
  { title: 'Homenajes luctuosos', image: '/images/preview/luctuoso.webp', description: 'Una invitación respetuosa para acompañar y honrar una memoria.' },
  { title: 'Y muchas más', image: '/images/preview/white.webp', description: 'Cuéntanos tu ocasión y creamos una experiencia a tu medida.' },
];
---

<section class="wrap sec" id="invitaciones" aria-labelledby="work-h">
  <SectionHeading class="rev" eyebrow={workHeading.eyebrow} title={workHeading.title} id="work-h" />

  <div class="work-grid invitation-grid">
    {
      invitationTypes.map((type, i) => (
        <a class:list={['work-card invitation-card', 'rev', i % 3 > 0 && `rev-d${i % 3}`]} href="#contact">
          <div class:list={['work-media', 'invitation-media', type.image && 'has-image']}>
            {type.image ? (
              <img src={withBase(type.image)} alt={`Vista previa de invitación para ${type.title}`} width="1240" height="1240" loading="lazy" decoding="async" />
            ) : (
              <span>BlassDesigns</span>
            )}
          </div>
          <div class="work-body">
            <div>
              <h3>{type.title}</h3>
              <span>{type.description}</span>
            </div>
          </div>
        </a>
      ))
    }
  </div>
</section>
