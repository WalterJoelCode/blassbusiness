---
import SectionHeading from '../SectionHeading.astro';
import { workHeading } from '~/data/highlights';

const invitationTypes = [
  'Baby showers', 'Bodas', 'Bautizos', 'Fiestas', 'Aniversarios',
  'Graduaciones', 'Festividades religiosas', 'Homenajes luctuosos', 'Y muchas más',
];
---

<section class="wrap sec" id="invitaciones" aria-labelledby="work-h">
  <SectionHeading class="rev" eyebrow={workHeading.eyebrow} title={workHeading.title} id="work-h" />

  <div class="work-grid invitation-grid">
    {
      invitationTypes.map((type, i) => (
        <a class:list={['work-card invitation-card', 'rev', i % 3 > 0 && `rev-d${i % 3}`]} href="#contact">
          <div class="work-media invitation-media">
            <span>BlassDesing</span>
          </div>
          <div class="work-body">
            <div>
              <h3>{type}</h3>
              <span>Diseño digital personalizado</span>
            </div>
          </div>
        </a>
      ))
    }
  </div>
</section>
