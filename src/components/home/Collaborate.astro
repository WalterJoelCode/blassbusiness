---
import Icon from '../Icon.astro';
import Button from '../Button.astro';
import siteConfig from '~/config/site';
import { collaborate } from '~/data/highlights';
---

<section class="wrap sec" aria-labelledby="collab-h">
  <div class="collab-grid">
    <div class="collab-visual rev">
      <div class="mocks">
        <div class="mock mock-a mock-placeholder" aria-label="Espacio reservado para imagen de invitación en sobre">
          <span>Invitación en sobre</span>
        </div>
        <div class="mock mock-b mock-placeholder" aria-label="Espacio reservado para imagen de invitación digital">
          <span>Experiencia digital</span>
        </div>
      </div>
    </div>

    <div class="collab-copy rev rev-d1">
      <p class="eyebrow">{collaborate.eyebrow}</p>
      <h2 class="d3 collab-h" id="collab-h"><b>{collaborate.title}</b></h2>
      <p class="collab-sub">{collaborate.body}</p>

      <div class="collab-panel">
        <a class="cbox" href={siteConfig.contact.whatsapp || '#contact'}>
          <i><Icon name="phone" /></i>
          <span>
            <span class="cbox-lbl">WhatsApp</span>
            <span class="cbox-val">Abrir WhatsApp</span>
          </span>
        </a>
        <a class="cbox" href="#contact">
          <i><Icon name="instagram" /></i>
          <span>
            <span class="cbox-lbl">Instagram</span>
            <span class="cbox-val">Abrir Instagram</span>
          </span>
        </a>
      </div>

      <Button href={siteConfig.contact.whatsapp || '#contact'} variant="ink" icon="phone">{collaborate.ctaLabel}</Button>
    </div>
  </div>
</section>
