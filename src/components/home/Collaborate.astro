---
import Icon from '../Icon.astro';
import siteConfig from '~/config/site';
import { collaborate } from '~/data/highlights';
import { withBase } from '~/lib/utils';
---

<section class="wrap sec" id="experiencia" aria-labelledby="collab-h">
  <div class="collab-grid">
    <div class="collab-intro rev">
      <p class="eyebrow">{collaborate.eyebrow}</p>
      <h2 class="d3 collab-h" id="collab-h"><b>{collaborate.title}</b></h2>
    </div>

    <div class="collab-visual rev" aria-label="De una invitación en sobre a una experiencia digital">
        <div class="mocks">
          <div class="mock mock-a" aria-label="Invitación en sobre">
            <img
              src={withBase('/images/welcome/beforeinvitation.webp')}
              alt="Invitación en sobre"
              width="800"
              height="800"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="mock mock-b" aria-label="Experiencia digital">
            <img
              src={withBase('/images/welcome/afterinvitation.webp')}
              alt="Experiencia digital"
              width="800"
              height="800"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
    </div>

    <div class="collab-details rev rev-d1">
      <p class="collab-sub">{collaborate.body}</p>

      <div class="collab-panel">
        <a class="cbox" href={siteConfig.contact.whatsapp || '#contact'}>
          <i><Icon name="phone" /></i>
          <span>
            <span class="cbox-lbl">WhatsApp</span>
            <span class="cbox-val">Abrir WhatsApp</span>
          </span>
        </a>
        <a class="cbox" href={siteConfig.contact.instagram || '#contact'}>
          <i><Icon name="instagram" /></i>
          <span>
            <span class="cbox-lbl">Instagram</span>
            <span class="cbox-val">Abrir Instagram</span>
          </span>
        </a>
      </div>
    </div>
  </div>
</section>
