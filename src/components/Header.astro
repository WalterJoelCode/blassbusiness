---
import Icon from './Icon.astro';
import Button from './Button.astro';
import siteConfig from '~/config/site';
import { primaryNav, mobileExtraNav } from '~/data/navigation';
import { withBase } from '~/lib/utils';

const path = Astro.url.pathname;
const isHome = path === '/' || path === '';

/** Exact match gets `aria-current="page"`; an ancestor section is only styled. */
function state(href: string) {
  if (href === '/') return isHome ? 'page' : null;
  if (path === href) return 'page';
  return path.startsWith(href) ? 'section' : null;
}

/** On the homepage, nav items with an anchor scroll instead of navigating. */
function target(href: string, anchor?: string) {
  return isHome && anchor ? anchor : href;
}
---

<header class="hdr" id="top">
  <div class="wrap hdr-in">
    <a class="brand" href="/">
      <img
        class="brand-light"
        src={withBase(siteConfig.logo.header.src)}
        alt={`${siteConfig.name} — home`}
        width={siteConfig.logo.header.width}
        height={siteConfig.logo.header.height}
        fetchpriority="high"
        decoding="async"
      />
      <img
        class="brand-dark"
        src={withBase(siteConfig.logo.footer.src)}
        alt={`${siteConfig.name} — home`}
        width={siteConfig.logo.footer.width}
        height={siteConfig.logo.footer.height}
        decoding="async"
      />
    </a>

    <nav class="nav" aria-label="Primary">
      {
        primaryNav.map((item) => {
          const s = state(item.href);
          return (
            <a
              href={target(item.href, item.anchor)}
              aria-current={s === 'page' ? 'page' : undefined}
              class={s === 'section' ? 'is-section' : undefined}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <div class="hdr-actions">
      <Button href={siteConfig.contact.whatsapp || '#contact'} variant="ink" class="hdr-cta" icon="phone">WhatsApp</Button>
      <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Cambiar a modo oscuro" aria-pressed="false">
        <Icon name="moon" />
        <span class="sr-only">Cambiar a modo oscuro</span>
      </button>
      <button class="burger" id="burger" aria-label="Abrir menú" aria-expanded="false" aria-controls="mnav">
        <Icon name="menu" />
      </button>
    </div>
  </div>

  <div class="mnav" id="mnav">
    <nav aria-label="Mobile">
      {
        [...primaryNav, ...mobileExtraNav].map((item) => {
          const s = state(item.href);
          return (
            <a href={item.href} aria-current={s === 'page' ? 'page' : undefined}>
              {item.label}
            </a>
          );
        })
      }
    </nav>
    <Button href={siteConfig.contact.whatsapp || '#contact'} variant="ink" icon="phone">WhatsApp</Button>
  </div>
</header>

<script>
  const burger = document.getElementById('burger');
  const panel = document.getElementById('mnav');
  const themeToggle = document.getElementById('theme-toggle');
  const root = document.documentElement;

  const setTheme = (theme: 'light' | 'dark', save = true) => {
    root.dataset.theme = theme;
    if (save) localStorage.setItem('swp-theme', theme);

    const dark = theme === 'dark';
    const icon = themeToggle?.querySelector('use');
    const label = dark ? 'Cambiar a modo claro' : 'Cambiar a modo oscuro';
    if (icon) icon.setAttribute('href', dark ? '#i-sun' : '#i-moon');
    themeToggle?.setAttribute('aria-label', label);
    themeToggle?.setAttribute('aria-pressed', dark ? 'true' : 'false');
    themeToggle?.querySelector('.sr-only')?.replaceChildren(label);
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', dark ? '#121613' : '#c8f14d');
  };

  setTheme(root.dataset.theme === 'dark' ? 'dark' : 'light', false);
  themeToggle?.addEventListener('click', () => setTheme(root.dataset.theme === 'dark' ? 'light' : 'dark'));

  if (burger && panel) {
    const OPEN_LABEL = 'Abrir menú';
    const CLOSE_LABEL = 'Cerrar menú';

    const setIcon = (open: boolean) => {
      const use = burger.querySelector('use');
      if (use) use.setAttribute('href', open ? '#i-close' : '#i-menu');
    };

    const setOpen = (open: boolean) => {
      panel.classList.toggle('open', open);
      burger.setAttribute('aria-expanded', open ? 'true' : 'false');
      burger.setAttribute('aria-label', open ? CLOSE_LABEL : OPEN_LABEL);
      setIcon(open);
    };

    burger.addEventListener('click', () => {
      const open = !panel.classList.contains('open');
      setOpen(open);
      if (open) panel.querySelector<HTMLAnchorElement>('a')?.focus();
    });

    // Close after a link is chosen.
    panel.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });

    // Escape closes and returns focus to the trigger.
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && panel.classList.contains('open')) {
        setOpen(false);
        burger.focus();
      }
    });

    // Never leave the drawer open when it is no longer reachable.
    const wide = window.matchMedia('(min-width: 1001px)');
    wide.addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
  }
</script>
