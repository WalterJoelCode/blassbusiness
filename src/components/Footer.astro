---
import Icon from './Icon.astro';
import siteConfig from '~/config/site';

const year = new Date().getFullYear();
---

<footer class="ftr">
  <div class="wrap ftr-top">
    <div>
      <a class="ftr-brand" href="/">
        <img
          src={siteConfig.logo.footer.src}
          alt={`${siteConfig.name} — home`}
          width={siteConfig.logo.footer.width}
          height={siteConfig.logo.footer.height}
          loading="lazy"
          decoding="async"
        />
      </a>
      <p class="ftr-about">{siteConfig.about}</p>
      <div class="ftr-soc">
        {
          siteConfig.social.map((s) => (
            <a href={s.href} aria-label={s.label} rel={s.href.startsWith('http') ? 'noopener noreferrer' : undefined} target={s.href.startsWith('http') ? '_blank' : undefined}>
              <Icon name={s.icon} class="ic-sm" />
            </a>
          ))
        }
      </div>
    </div>

    <div>
      <h2>Contacto</h2>
      <div class="ftr-cbox">
        <span><a href={siteConfig.contact.whatsapp} rel="noopener noreferrer" target="_blank">WhatsApp</a> · <a href="https://www.instagram.com/" rel="noopener noreferrer" target="_blank">Instagram</a></span>
      </div>
    </div>
  </div>

  <div class="wrap ftr-bot">
    <p>&copy; {year} {siteConfig.copyrightHolder}</p>
    <p>Sitio web desarrollado por <a href="mailto:waltercastil2019@outlook.com">WalterJoelCode</a></p>
  </div>
</footer>
