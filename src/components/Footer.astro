---
import Icon from './Icon.astro';
import siteConfig from '~/config/site';
import { withBase } from '~/lib/utils';

const year = new Date().getFullYear();
---

<footer class="ftr">
  <div class="wrap ftr-top">
    <div>
      <a class="ftr-brand" href="/">
        <img
          src={withBase(siteConfig.logo.footer.src)}
          alt={`${siteConfig.name} — home`}
          width={siteConfig.logo.footer.width}
          height={siteConfig.logo.footer.height}
          loading="lazy"
          decoding="async"
        />
      </a>
      <p class="ftr-about">{siteConfig.about}</p>
      <div class="ftr-soc">
        {
          siteConfig.social.map((s) => (
            <a href={s.href} aria-label={s.label} rel={s.href.startsWith('http') ? 'noopener noreferrer' : undefined} target={s.href.startsWith('http') ? '_blank' : undefined}>
              <Icon name={s.icon} class="ic-sm" />
            </a>
          ))
        }
      </div>
    </div>

    <div>
      <h2>Contacto</h2>
      {siteConfig.contact.whatsapp && (
        <div class="ftr-cbox"><span><a href={siteConfig.contact.whatsapp} rel="noopener noreferrer" target="_blank">WhatsApp</a></span></div>
      )}
      {siteConfig.social.map((social) => (
        <div class="ftr-cbox"><span><a href={social.href} rel="noopener noreferrer" target="_blank">{social.label}</a></span></div>
      ))}
    </div>
  </div>

  <div class="wrap ftr-bot">
    <p>&copy; {year} {siteConfig.copyrightHolder}</p>
    <p>Sitio web de {siteConfig.copyrightHolder}</p>
  </div>
</footer>
