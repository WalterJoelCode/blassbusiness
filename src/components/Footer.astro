---
import Icon from './Icon.astro';
import siteConfig from '~/config/site';
import { withBase } from '~/lib/utils';

const year = new Date().getFullYear();
const developerName = 'Walter Joel';
const developerLinkedIn = siteConfig.contact.linkedin.trim();
---

<footer class="ftr">
  <div class="wrap ftr-in">
    <div class="ftr-brand-wrap">
      <a class="ftr-brand" href={withBase('/')}>
        <img
          src={withBase(siteConfig.logo.footer.src)}
          alt={`${siteConfig.name} — home`}
          width={siteConfig.logo.footer.width}
          height={siteConfig.logo.footer.height}
          loading="lazy"
          decoding="async"
        />
      </a>
    </div>
    <p class="ftr-credit">
      Desarrollado por {developerName}
      {developerLinkedIn && (
        <a href={developerLinkedIn} rel="noopener noreferrer" target="_blank">
          <Icon name="linkedin" class="ic-xs" /> LinkedIn
        </a>
      )}
    </p>
  </div>

  <div class="wrap ftr-bot">
    <p>&copy; {year} {siteConfig.copyrightHolder}</p>
    <p>Sitio web de {siteConfig.copyrightHolder}</p>
  </div>
</footer>
